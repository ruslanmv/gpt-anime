NEXT_PUBLIC_SHOW_BABYLON_INSPECTOR = false
TAMAGUI_TARGET=web

# WatsonX.ai Configuration
# Get your IBM Cloud API Key from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Get your Project ID from your WatsonX.ai project
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Optional: Specify a different model (default: ibm/granite-3-8b-instruct)
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Google Cloud API Key for Text-to-Speech and Speech-to-Text
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_cloud_api_key_here
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_cloud_api_key_here
