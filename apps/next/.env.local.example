# Copy this file to .env.local and fill in your actual credentials
# Never commit .env.local to version control!

NEXT_PUBLIC_SHOW_BABYLON_INSPECTOR=false
TAMAGUI_TARGET=web

# ============================================
# WatsonX.ai Configuration
# ============================================
# 1. Go to https://cloud.ibm.com/iam/apikeys
# 2. Create a new API key or use an existing one
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# 1. Go to https://dataplatform.cloud.ibm.com/wx/home
# 2. Open your project
# 3. Go to "Manage" tab > "General" > Copy the Project ID
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Optional: Choose a different model
# Available models: ibm/granite-3-8b-instruct, ibm/granite-13b-chat-v2, meta-llama/llama-2-70b-chat
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ============================================
# Google Cloud Configuration
# ============================================
# Required for Text-to-Speech and Speech-to-Text
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an API key
# 3. Enable "Cloud Text-to-Speech API" and "Cloud Speech-to-Text API"

# Backend API key (server-side only)
GOOGLE_API_KEY=your_google_cloud_api_key_here

# Frontend API key (exposed to client - can be the same as above)
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_cloud_api_key_here
